# DeepSeek API key — used by Vercel deploy ONLY (local dev uses claude CLI).
# Set this in Vercel project env vars; local dev can leave it blank.
DEEPSEEK_API_KEY=
# Optional override of base URL for testing
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# When set to 'vercel', Try Fix UI is disabled (Vercel can't run claude CLI / no filesystem).
# Vercel build auto-sets PUBLIC_DEPLOY_TARGET=vercel via the deploy script.
PUBLIC_DEPLOY_TARGET=
# Per-IP LLM calls per hour
RATE_LIMIT_PER_HOUR=20
# Max bytes accepted on /api/llm body messages[].content total
RATE_LIMIT_MAX_PAYLOAD_BYTES=32768
# Regex allow-list for Jira hosts (without scheme)
ALLOWED_JIRA_HOST_REGEX=^[a-z0-9-]+\.atlassian\.net$
# Colon-separated absolute prefixes that connected projects (Try Fix) must live under.
# Server rejects any projectPath outside these roots. Default = $HOME.
ALLOWED_PROJECT_ROOTS=
# Optional Sentry DSN
SENTRY_DSN=
